# ── Email inbox ──────────────────────────────────────────────────────────────
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your@gmail.com
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password

# ── Trigger ───────────────────────────────────────────────────────────────────
# Any email whose subject OR body contains this string will be processed
TRIGGER_CODE=[WGPOST]

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Web Gecko business info ───────────────────────────────────────────────────
BUSINESS_NAME=Web Gecko
BUSINESS_WEBSITE=https://webgecko.com.au
# Default referral/signup code embedded in every post
REFERRAL_CODE=GECKO25

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-something-random
DATABASE_PATH=data/posts.db
UPLOADS_PATH=data/images
# How often to check email (seconds)
CHECK_INTERVAL=120
