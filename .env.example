# ── Email inbox ──────────────────────────────────────────────────────────────
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
EMAIL_ADDRESS=your@gmail.com
# For Gmail use an App Password: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password

# ── Trigger code ─────────────────────────────────────────────────────────────
# Clients put this anywhere in the email subject to trigger automation
TRIGGER_CODE=[WGPOST]

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Web Gecko business info ───────────────────────────────────────────────────
BUSINESS_NAME=Web Gecko
BUSINESS_WEBSITE=https://webgecko.com.au
REFERRAL_CODE=GECKO25

# ── Dashboard login ───────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-to-something-strong
SECRET_KEY=change-me-to-something-random

# ── Facebook (Meta Graph API) ─────────────────────────────────────────────────
# Page Access Token — get from developers.facebook.com/tools/explorer
FACEBOOK_PAGE_TOKEN=
# Your Facebook Page ID (shown in page settings)
FACEBOOK_PAGE_ID=

# ── Instagram (same Meta token, different account ID) ─────────────────────────
# Instagram Business Account ID — linked to your Facebook Page
INSTAGRAM_ACCOUNT_ID=

# ── TikTok for Business ───────────────────────────────────────────────────────
# Requires TikTok for Business app approval
# Get from: developers.tiktok.com
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ── X / Twitter ───────────────────────────────────────────────────────────────
# Requires X Basic plan ($100/mo) for write access
# Get from: developer.twitter.com → Project → Keys and Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_PATH=data/posts.db
UPLOADS_PATH=data/images
# How often to check email (seconds)
CHECK_INTERVAL=120
