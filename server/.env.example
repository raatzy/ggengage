# Copy this to .env for local development (never commit .env)
# Install python-dotenv and call load_dotenv() if you want auto-loading locally.

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...          # test key for dev, sk_live_... for prod
STRIPE_WEBHOOK_SECRET=whsec_...        # from Stripe dashboard → Webhooks

# ── Licensing ─────────────────────────────────────────────────────────────────
LICENSE_HMAC_SECRET=GGEngagePhotoProc-k9xP2025#mR7   # MUST match app

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_API_KEY=change-this-to-something-long-and-random

# ── Email (Gmail example) ─────────────────────────────────────────────────────
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=youraddress@gmail.com
